# Supabase (Project Settings > API). Both are compiled into the app bundle and
# readable by anyone, so only ever the URL and the publishable key here —
# never the service role key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=

# Google sign-in (Google Cloud Console > APIs & Services > Credentials).
# Supabase checks the ID token's audience against the web client ID, so both
# client IDs are needed even though only iOS signs in natively.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# The iOS client ID reversed (com.googleusercontent.apps.<id>). Leave empty to
# build without Google sign-in.
GOOGLE_IOS_URL_SCHEME=

# Your own iOS bundle identifier for device builds, so it doesn't collide with
# another contributor's Personal Team. Not needed for the Simulator.
LOCAL_IOS_BUNDLE_ID=

# Set to 1 on a free Apple account, which can't sign the Sign in with Apple
# capability.
WITHOUT_APPLE_SIGN_IN=
